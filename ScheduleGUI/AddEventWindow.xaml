<Window x:Class="ScheduleGUI.AddEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScheduleGUI"
        xmlns:conv="clr-namespace:ScheduleGUI.Convertors"
        xmlns:models="clr-namespace:Models.Enums;assembly=Models"
        mc:Ignorable="d"
        AllowsTransparency="False" WindowStyle="ThreeDBorderWindow"
        Title="Adaugă un Eveniment Nou" Height="550" Width="400" WindowStartupLocation="CenterScreen" Background="#F0F4F8">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495E"/>
        </Style>

        <conv:EnumToBooleanConverter x:Key="ConvOnline" />
        <conv:EnumToBooleanConverter x:Key="ConvReminder" />
        <conv:EnumToBooleanConverter x:Key="ConvRecurent" />
    </Window.Resources>


    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Detalii Eveniment" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Completeaza informatiile de mai jos" Foreground="#64748B" FontSize="13"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-15,0" Padding="0,0,15,0">
            <StackPanel>

                <TextBlock Text="INFORMATII GENERALE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,10,0,8"/>

                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Titlu Eveniment" Foreground="#475569" FontSize="12" Padding="0,0,0,5"/>
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="5,2">
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="14"/>
                        </Border>

                        <Label Content="Descriere" Foreground="#475569" FontSize="12" Padding="0,15,0,5"/>
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="5,2">
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent" FontSize="14" 
                                     Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </Border>

                        <Label Content="Apartine de Obiectivul (Optional)" Foreground="#475569" FontSize="12" Padding="0,15,0,5"/>

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="5">
                            <ComboBox x:Name="cmbObiective" 
                                      DisplayMemberPath="Title" 
                                      SelectedItem="{Binding ParentObjective, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#334155" Margin="2">
                                <ComboBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </Border>



                <TextBlock Text="INTERVAL" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,10,0,8"/>

                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,15">

                            <StackPanel Orientation="Vertical" Margin="0,15,0,15">
                                <StackPanel Margin="0,0,30,0">
                                    <Label Content="Data si Ora Inceperii" Foreground="#475569" FontSize="12" Padding="0,0,0,5" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <DatePicker x:Name="dpDataInceput" Width="130" Margin="0,0,50,0"/>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="5,2">
                                            <TextBox x:Name="txtOraInceput" Width="60" MaxLength="5" FontSize="14"
                                                     VerticalContentAlignment="Center" ToolTip="Format: HH:mm"
                                                      BorderThickness="0" Background="Transparent"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel>
                                    <Label Content="Data si Ora Finalizarii" Foreground="#475569" FontSize="12" Padding="0,0,0,5" Margin="0,10,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <DatePicker x:Name="dpDataSfarsit" Width="130" Margin="0,0,50,0"/>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="5,2">
                                            <TextBox x:Name="txtOraSfarsit" Width="60" MaxLength="5" FontSize="14"
                                                 VerticalContentAlignment="Center" ToolTip="Format: HH:mm"
                                                 BorderThickness="0" Background="Transparent"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>

                        <Label Content="Optiuni" Foreground="#475569" FontSize="12" Padding="0,10,0,5"/>
                        <WrapPanel>
                            <CheckBox Content="Online" IsChecked="{Binding Options, Converter={StaticResource ConvOnline}, ConverterParameter={x:Static models:EventOptions.Online}, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,20,5"/>
                            <CheckBox Content="Reminder" IsChecked="{Binding Options, Converter={StaticResource ConvReminder}, ConverterParameter={x:Static models:EventOptions.Reminder}, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,20,5"/>
                            <CheckBox Content="Recurent" IsChecked="{Binding Options, Converter={StaticResource ConvRecurent}, ConverterParameter={x:Static models:EventOptions.Recurent}, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,5"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Eveniment Finalizat?" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold"/>
                        <CheckBox IsChecked="{Binding IsCompleted}" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="txtMesajEroare" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold" 
                       HorizontalAlignment="Center" Margin="0,5,0,5" TextWrapping="Wrap" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">

                <Button Content="Anuleaza" Width="100" Height="38" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#64748B" Margin="0,0,12,0" Click="BtnAnuleaza_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Salveaza Eveniment" Width="160" Height="38" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSalveaza_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
       
    </Grid>
</Window>
