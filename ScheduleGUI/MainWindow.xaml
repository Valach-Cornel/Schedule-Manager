<Window x:Class="ScheduleGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScheduleGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="1" Margin="20,10,20,15" VerticalAlignment="Center">

            <Border Background="White" CornerRadius="20" BorderBrush="#E2E8F0" BorderThickness="1" 
            Padding="12,5" Margin="0,0,15,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Color="Black" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14" Foreground="#94A3B8"/>
                    <TextBox x:Name="txtCauta" TextChanged="txtCauta_TextChanged" 
                     Width="180" FontSize="14" Foreground="#334155" 
                     Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                     ToolTip="Cauta un eveniment..."/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" 
            Padding="5,2" Margin="0,0,15,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Stare:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                    <ComboBox x:Name="cmbFiltruStare" SelectionChanged="cmbFiltruStare_SelectionChanged" SelectedIndex="0"
                      Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#334155" Width="130">
                        <ComboBoxItem Content="Toate"/>
                        <ComboBoxItem Content="Active / Viitoare"/>
                        <ComboBoxItem Content="Finalizate"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" 
            Padding="5,2" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sortare:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                    <ComboBox x:Name="cmbSortare" SelectionChanged="cmbSortare_SelectionChanged" SelectedIndex="0"
                      Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#334155" Width="150">
                        <ComboBoxItem Content="Data (Crescator)"/>
                        <ComboBoxItem Content="Data (Descrescator)"/>
                    </ComboBox>
                </StackPanel>
            </Border>

        </WrapPanel>
        <ListBox x:Name="listaCarduri" 
                 Grid.Row="2"
                 Background="Transparent" 
                 BorderThickness="0" 
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 SelectionChanged="ListaCarduri_SelectionChanged"
                 Padding="10,10,10,10">

            <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Border Background="White" CornerRadius="12" Margin="10,10,10,20" Padding="25">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Color="LightGray" ShadowDepth="5" Opacity="0.4"/>
                            </Border.Effect>

                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding ParentObjective.Title, StringFormat='Obiectiv: {0}', TargetNullValue='Fără obiectiv'}" 
                                       FontSize="14" Foreground="#7F8C8D" FontStyle="Italic" Margin="0,0,0,20"/>

                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Inceput: " FontWeight="SemiBold" Foreground="#34495E" Width="80"/>
                                    <TextBlock Text="{Binding StartTime, StringFormat=dd/MM/yyyy HH:mm}" Foreground="#2C3E50"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Final: " FontWeight="SemiBold" Foreground="#34495E" Width="80"/>
                                    <TextBlock Text="{Binding EndTime, StringFormat=dd/MM/yyyy HH:mm}" Foreground="#2C3E50"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <TextBlock Text="Stare: " FontWeight="SemiBold" Foreground="#34495E" Width="80" VerticalAlignment="Center"/>

                                    <Border x:Name="bdStatus" Background="#E74C3C" CornerRadius="5" Padding="10,4">
                                        <TextBlock x:Name="labelStatus" Text="Nefinalizat" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="bdStatus" Property="Background" Value="#2ECC71"/>
                                <Setter TargetName="labelStatus" Property="Text" Value="FINALIZAT"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>

                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,10,10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform x:Name="noScale" ScaleX="1" ScaleY="1" />
                            </Setter.Value>
                        </Setter>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="Transparent" CornerRadius="8">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.025" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.025" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

        <Button Grid.Row="2" Content="+" Click="BtnDeschideAdaugare_Click" 
                HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Margin="0,0,15,15" Width="50" Height="50" 
                Background="#E74C3C" Foreground="White" FontSize="30" FontWeight="Bold"
                BorderThickness="0" Cursor="Hand" ToolTip="Adauga un eveniment nou">

            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="30"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" Color="Black" ShadowDepth="2" Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
