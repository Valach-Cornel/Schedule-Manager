<Window x:Class="ScheduleGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScheduleGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="800">

    <Grid Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="1" Margin="20,10,20,15" VerticalAlignment="Center">

            <Border Background="White" CornerRadius="20" BorderBrush="#E2E8F0" BorderThickness="1" 
            Padding="12,5" Margin="0,0,15,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Color="Black" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14" Foreground="#94A3B8"/>
                    <TextBox x:Name="txtCauta" TextChanged="txtCauta_TextChanged" 
                     Width="180" FontSize="14" Foreground="#334155" 
                     Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                     ToolTip="Cauta un eveniment..."/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" 
            Padding="5,2" Margin="0,0,15,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Stare:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                    <ComboBox x:Name="cmbFiltruStare" SelectionChanged="cmbFiltruStare_SelectionChanged" SelectedIndex="0"
                      Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#334155" Width="130">
                        <ComboBoxItem Content="Toate"/>
                        <ComboBoxItem Content="Active / Viitoare"/>
                        <ComboBoxItem Content="Finalizate"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" 
            Padding="5,2" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sortare:" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                    <ComboBox x:Name="cmbSortare" SelectionChanged="cmbSortare_SelectionChanged" SelectedIndex="0"
                      Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#334155" Width="150">
                        <ComboBoxItem Content="Data (Crescator)"/>
                        <ComboBoxItem Content="Data (Descrescator)"/>
                    </ComboBox>
                </StackPanel>
            </Border>

        </WrapPanel>
        <ListBox x:Name="listaCarduri" 
                 Grid.Row="2"
                 Background="Transparent" 
                 BorderThickness="0" 
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 SelectionChanged="ListaCarduri_SelectionChanged"
                 Padding="10">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>

                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="0"/>
                        </Setter.Value>
                    </Setter>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" 
                                             To="-3" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" 
                                             To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,2" BorderBrush="#E2E8F0" Margin="0,20,0,10" Padding="0,0,0,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅 " FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name, StringFormat='{}{0:dd MMMM yyyy}'}" 
                                       FontSize="16" FontWeight="ExtraBold" Foreground="#1E293B" 
                                       VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="10" Margin="0,0,10,15" Padding="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Color="Black" ShadowDepth="1" Opacity="0.12"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#EEF2FF" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ParentObjective.Title, TargetNullValue='Fără obiectiv'}" 
                                           FontSize="12" FontWeight="Bold" Foreground="#4F46E5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ParentObjective.Category, StringFormat='({0})'}" 
                                           FontSize="11" Foreground="#818CF8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <CheckBox Grid.Column="1" IsChecked="{Binding IsCompleted, Mode=TwoWay}" 
                                  Content="Finalizat" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" 
                                  VerticalAlignment="Top" Cursor="Hand" Click="CheckBoxFinalizat_Click" />
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#1E293B" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🕒" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding StartTime, StringFormat='dd MMM yyyy, HH:mm'}" 
                                   FontSize="13" FontWeight="SemiBold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Text="{Binding Description}" FontSize="13" Foreground="#475569" 
                               TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>

                            <Border Grid.Row="4" Background="#F1F5F9" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Opțiuni: " FontSize="11" Foreground="#94A3B8" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Options}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Content="+" Click="BtnDeschideAdaugare_Click" 
                HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Margin="0,0,15,15" Width="50" Height="50" 
                Background="#E74C3C" Foreground="White" FontSize="30" FontWeight="Bold"
                BorderThickness="0" Cursor="Hand" ToolTip="Adauga un eveniment nou">

            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="30"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" Color="Black" ShadowDepth="2" Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
